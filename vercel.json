{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api-aurelia.onrender.com/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "https://api-aurelia.onrender.com/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}